	(text "Decoupling: C6, C7 at U1; C9, C8 at U2; C10 at U4"
		(exclude_from_sim no)
		(at 111.76 160.02 0)
		(effects
			(font
				(size 1.27 1.27)
				(italic yes)
			)
			(justify left top)
		)
		(uuid "2b144258-fca6-5833-8413-637aca4d8395")
	)
	(text "Isolated side: GND, +5V, -5V\nStation side: com, VCC"
		(exclude_from_sim no)
		(at 38.1 122 0)
		(effects
			(font
				(size 1.27 1.27)
				(italic yes)
			)
			(justify left top)
		)
		(uuid "46bd1ed0-e020-594a-8bbb-2aa8505cf9ad")
	)
	(text "1. U1 pin 5 is bent up and wired in the air straight to the BNC centre: no pad, no copper.\n2. RA1, RA2: no trimmers. A wire joins all three holes of each.\n3. First stage gain 1 + R3/R8 = 6.13.\n4. REWORK (verified revision): R5 not fitted (DNP). REF3040AIDBZR (4.096 V) on the R5 pads: IN to +5V, GND to ground,\n    OUT to RA2 pin 1. 47k (R10) across RA2 holes 1-2, wire RA2 2-3. Vref = 4.096 V * R9/(47k + R9) = 0.719 V (measured 0.688 V).\n    Unreworked board: Vref = V(+5V) * R9/(R5 + R9) = 0.152 * V(+5V).\n5. Design: S = 0.5 V at pH 4 ... 2.45 V at pH 9.38, slope -6.13 V/V (measured with the REF3040 rework: -6.09 V/V).\n6. C1 and C5: ceramic only. C2-C4: 4.7-47 uF, 10 V or more."
		(exclude_from_sim no)
		(at 25.4 28 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "47006647-d307-53db-aa2f-be2a9499a3dd")
	)
	(text "pH electrode front end, release variant (no trimmers)"
		(exclude_from_sim no)
		(at 25.4 22.86 0)
		(effects
			(font
				(size 2.54 2.54)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "86351a0c-b3f5-539a-ba37-b1f8d4117a9d")
	)
	(text "Unused halves: followers"
		(exclude_from_sim no)
		(at 165.1 50.8 0)
		(effects
			(font
				(size 1.27 1.27)
				(italic yes)
			)
			(justify left bottom)
		)
		(uuid "be2860ad-1e37-501c-ad05-5563d2c079aa")
	)
